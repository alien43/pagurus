{
  "service": "whoami",
  "start": {
    "kind": "compose",
    "file": "/etc/pagurus/whoami/compose.yaml"
  },
  "project_prefix": "whoami",
  "members": [
    "node1",
    "node2",
    "node3"
  ],
  "prefer": [
    "node1",
    "node2",
    "node3"
  ],
  "grace": "10s",
  "etcd": {
    "endpoints": [
      "192.0.2.1:2379",
      "192.0.2.2:2379",
      "192.0.2.3:2379"
    ],
    "dial_timeout": "3s",
    "op_timeout": "2s"
  },
  "lease": {
    "ttl": "20s",
    "renew_interval": "2s",
    "margin": "2s"
  },
  "self_fence": {
    "stop_budget": "6s",
    "kill_budget": "3s"
  },
  "fence": {
    "api_timeout": "15s",
    "unverified": "proceed",
    "unverified_wait": "40s",
    "retry_interval": "5s",
    "reboot_margin": "10s"
  },
  "health": {
    "interval": "5s",
    "start_period": "30s",
    "failures": 3,
    "max_restarts": 2,
    "http": "http://{ip}:80/health",
    "instance": "whoami-1",
    "timeout": "3s",
    "release_backoff": "2m"
  },
  "watchdog": {
    "mode": "systemd"
  },
  "state_dir": "/run/pagurus"
}
